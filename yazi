#!/bin/sh
_yazifetch() {
  local dotbin="$HOME/.dotfiles/bin"

  local bin=""
  local exe=""
  case "$(uname -s)" in
    Linux)        bin="unknown-linux-musl" ;;
    MINGW*|MSYS*) bin="pc-windows-msvc" exe=".exe" ;;
    *)            echo "error: unsupported os"; return ;;
  esac

  local rel="https://skyfalconua.github.io/pkgs/yazi/VERSION"
  local ver=`curl -sL "${rel}" | xargs`

  for util in 'ya' 'yazi'; do
    local pkg="https://skyfalconua.github.io/pkgs/yazi/${util}-${ver}-$(uname -m)-${bin}${exe}"
    local outfile=""${dotbin}/${util}${exe}""

    curl -sL  "${pkg}" > "${outfile}" && \
    chmod 755 "${outfile}" && \
    echo "created ${outfile} (v${ver})"
  done
}
_yazifetch; unset _yazifetch
